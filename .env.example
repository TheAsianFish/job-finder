# Copy to .env and fill in. Never commit .env.
OPPORTUNITY_RADAR_ENV=local
OPPORTUNITY_RADAR_DB_URL=sqlite:///./data/opportunity_radar.db
DISCORD_WEBHOOK_URL=
OPPORTUNITY_RADAR_SECRET_KEY=change-me-to-a-random-string
# Optional local LLM (disabled unless configured)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional paid search API for career-page discovery (never required)
SEARCH_API_KEY=
# Contact info placed in the User-Agent so site operators can reach you
OPPORTUNITY_RADAR_CONTACT=
